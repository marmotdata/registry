{
	"name": "marmot-registry",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"prebuild:data": "node scripts/build.mjs && node scripts/build-index.mjs && node scripts/pull-plugin-artifacts.mjs && node scripts/render-docs.mjs",
		"sign-index": "node scripts/sign-index.mjs",
		"pull-plugin-artifacts": "node scripts/pull-plugin-artifacts.mjs",
		"sync-plugin-versions": "node scripts/sync-plugin-versions.mjs",
		"dev": "pnpm prebuild:data && vite dev",
		"start": "pnpm dev",
		"build": "pnpm prebuild:data && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@marmotdata/svelte": "^0.1.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.4.0",
		"@types/prismjs": "^1.26.6",
		"js-yaml": "^4.1.0",
		"marked": "^15.0.12",
		"prismjs": "^1.30.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.6",
		"typescript": "^5.8.3",
		"vite": "^6.4.3"
	},
	"dependencies": {
		"@marmotdata/css": "^0.1.4",
		"@marmotdata/elements": "^0.1.4",
		"@marmotdata/icons": "^0.1.4",
		"@marmotdata/tokens": "^0.1.4"
	}
}
